{
  "name": "prompt-studio",
  "productName": "Prompt Studio",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first desktop app for versioned prompt development with hard cost gates, injection-resistant prompt assembly, and a measured-not-assumed security model.",
  "author": "Levi Stoddard",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && node tests/e2e/run-e2e.mjs",
    "package": "node scripts/package.mjs",
    "verify-security": "node scripts/verify-security.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@google/genai": "2.29.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "diff": "9.0.0",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
